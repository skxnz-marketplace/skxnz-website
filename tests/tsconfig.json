{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "outDir": "./.build",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "../lib/returns/create-return-request.ts",
    "../lib/support/create-support-ticket.ts",
    "../lib/support/add-support-ticket-message.ts",
    "../lib/orders/create-order-intent.ts",
    "../lib/orders/read-seller-orders.ts",
    "../lib/orders/seller-update-line-fulfilment.ts",
    "../lib/orders/admin-update-order-status.ts",
    "../lib/orders/read-admin-orders.ts",
    "../lib/returns/admin-update-return-status.ts",
    "../lib/support/admin-support-actions.ts"
  ]
}
