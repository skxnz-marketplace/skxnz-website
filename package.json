{
  "name": "skxnz-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "NEXT_TEST_WASM=1 NEXT_TEST_WASM_DIR=./node_modules/@next/swc-wasm-nodejs next dev",
    "build": "NEXT_TEST_WASM=1 NEXT_TEST_WASM_DIR=./node_modules/@next/swc-wasm-nodejs next build && node scripts/fix-next-vendor-chunks.mjs",
    "start": "next start",
    "lint": "eslint .",
    "check:colors": "node scripts/check-colors.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@prisma/client": "^6.7.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/swc-wasm-nodejs": "^15.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "^8.4.49",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
