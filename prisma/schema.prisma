generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  RIDER
  ADMIN
}

enum SellerStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
  SUSPENDED
}

enum RiderStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  BACKORDERED
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

enum WishlistStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  NOT_CONNECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  NOT_ASSIGNED
  PICKUP_PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
}

enum ReturnStatus {
  NOT_REQUESTED
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKED_UP
  REFUNDED
  CLOSED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  WAITING_ON_SELLER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum CommunityPostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  IP_OR_COPYRIGHT
  MISLEADING
  OTHER
}

enum AiJobType {
  TITLE_GENERATION
  DESCRIPTION_GENERATION
  VIDEO_PROMPT_GENERATION
  STYLIST
  BUYER_ASSISTANT
  OUTFIT_BUILDER
  SELLER_VALIDATION
  ADMIN_SUMMARY
  SUPPORT_TRIAGE
  VISUAL_SEARCH
  TRY_ON
}

enum AiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  REVIEW_REQUIRED
}

enum ContentStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SearchEntityType {
  PRODUCT
  BRAND
  CATEGORY
  COLLECTION
  PAGE
}

enum AuditActorType {
  USER
  SELLER
  RIDER
  ADMIN
  SYSTEM
  AI
}

enum SellerValidationStatus {
  PENDING
  PASSED
  FAILED
  NEEDS_REVIEW
  APPROVED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  role             UserRole
  profile          UserProfile?
  buyerProfile     BuyerProfile?
  sellerProfile    SellerProfile?
  riderProfile     RiderProfile?
  adminUser        AdminUser?
  supportTickets   SupportTicket[]   @relation("UserSupportTickets")
  supportMessages  SupportMessage[]  @relation("UserSupportMessages")
  aiJobs           AiJob[]           @relation("UserAiJobs")
  aiUsageLogs      AiUsageLog[]      @relation("UserAiUsageLogs")
  aiConversations  AiConversation[]  @relation("UserAiConversations")
  aiOutfitRequests AiOutfitRequest[] @relation("UserAiOutfitRequests")
  aiTryOnConsents  AiTryOnConsent[]  @relation("UserAiTryOnConsents")
  aiTryOnResults   AiTryOnResult[]   @relation("UserAiTryOnResults")
  addresses        Address[]
  stylePreferences StylePreference[]
  communityPosts   CommunityPost[]
  communityLikes   CommunityLike[]
  communitySaves   CommunitySave[]
  reports          Report[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  avatarUrl       String?  @map("avatar_url")
  phoneNumber     String?  @map("phone_number")
  city            String?
  state           String?
  country         String?
  stylePreference String?  @map("style_preference")
  preferredFit    String?  @map("preferred_fit")
  budgetRange     String?  @map("budget_range")
  preferencesJson Json?    @map("preferences_json")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model BuyerProfile {
  id               String          @id @default(cuid())
  userId           String          @unique @map("user_id")
  displayName      String          @map("display_name")
  waitlistJoinedAt DateTime?       @map("waitlist_joined_at")
  waitlistStatus   String          @default("PENDING") @map("waitlist_status")
  notes            String?         @db.Text
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  carts            Cart[]
  wishlists        Wishlist[]
  orders           Order[]
  reviews          Review[]
  returnRequests   ReturnRequest[]
  supportTickets   SupportTicket[] @relation("BuyerSupportTickets")
  addresses        Address[]
  savedBrands      SavedBrand[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([waitlistStatus])
  @@map("buyers")
}

model SellerProfile {
  id               String                    @id @default(cuid())
  userId           String                    @unique @map("user_id")
  brandId          String?                   @unique @map("brand_id")
  storeName        String                    @map("store_name")
  slug             String                    @unique
  bio              String?                   @db.Text
  website          String?
  instagramPage    String?                   @map("instagram_page")
  phoneNumber      String?                   @map("phone_number")
  city             String?
  gstAvailable     Boolean                   @default(false) @map("gst_available")
  canShipOrders    Boolean                   @default(false) @map("can_ship_orders")
  productCount     Int                       @default(0) @map("product_count")
  status           SellerStatus              @default(PENDING)
  applicationNote  String?                   @map("application_note") @db.Text
  approvedAt       DateTime?                 @map("approved_at")
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand            Brand?                    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  products         Product[]
  inventoryRecords Inventory[]
  supportTickets   SupportTicket[]           @relation("SellerSupportTickets")
  validations      SellerProductValidation[]
  aiJobs           AiJob[]                   @relation("SellerAiJobs")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  orderItems       OrderItem[]

  @@index([status])
  @@map("sellers")
}

model RiderProfile {
  id            String      @id @default(cuid())
  userId        String      @unique @map("user_id")
  displayName   String      @map("display_name")
  phoneNumber   String?     @map("phone_number")
  city          String?
  status        RiderStatus @default(ACTIVE)
  assignedZones Json?       @map("assigned_zones")
  notes         String?     @db.Text
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments     Shipment[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@map("riders")
}

model AdminUser {
  id              String          @id @default(cuid())
  userId          String          @unique @map("user_id")
  title           String?
  permissionsText String?         @map("permissions_text") @db.Text
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs       AuditLog[]
  supportTickets  SupportTicket[] @relation("AdminAssignedTickets")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Brand {
  id               String          @id @default(cuid())
  sourceBrandId    String?         @unique @map("source_brand_id")
  name             String
  slug             String          @unique
  tagline          String?
  shortDescription String?         @map("short_description") @db.Text
  description      String?         @db.Text
  brandCategory    String?         @map("brand_category")
  logoUrl          String?         @map("logo_url")
  heroImageUrl     String?         @map("hero_image_url")
  accentColor      String?         @map("accent_color")
  featured         Boolean         @default(false)
  topBrand         Boolean         @default(false) @map("top_brand")
  status           String          @default("Active")
  availabilityNote String?         @map("availability_note") @db.Text
  isDemo           Boolean         @default(true) @map("is_demo")
  sellerProfile    SellerProfile?
  products         Product[]
  heroes           BrandHero[]
  savedBy          SavedBrand[]
  searchKeywords   SearchKeyword[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  carouselSlides   CarouselSlide[]

  @@map("brands")
}

model Category {
  id               String          @id @default(cuid())
  sourceCategoryId String?         @unique @map("source_category_id")
  name             String
  displayName      String?         @map("display_name")
  slug             String          @unique
  description      String?         @db.Text
  imageUrl         String?         @map("image_url")
  href             String?
  displayOrder     Int             @default(0) @map("display_order")
  featured         Boolean         @default(false)
  status           String          @default("Active")
  isDemo           Boolean         @default(true) @map("is_demo")
  products         Product[]
  carouselSlides   CarouselSlide[]
  searchKeywords   SearchKeyword[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("categories")
}

model Collection {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?             @db.Text
  imageUrl       String?             @map("image_url")
  href           String?
  status         String              @default("Demo")
  isDemo         Boolean             @default(true) @map("is_demo")
  products       ProductCollection[]
  carouselSlides CarouselSlide[]
  searchKeywords SearchKeyword[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@map("collections")
}

model Product {
  id               String                    @id @default(cuid())
  sourceProductId  String?                   @unique @map("source_product_id")
  sellerProfileId  String?                   @map("seller_profile_id")
  brandId          String                    @map("brand_id")
  categoryId       String                    @map("category_id")
  name             String
  slug             String                    @unique
  sku              String?                   @unique
  subcategory      String?
  gender           String?
  shortDescription String                    @map("short_description")
  description      String                    @db.Text
  priceCents       Int                       @map("price_cents")
  salePriceCents   Int?                      @map("sale_price_cents")
  currency         String                    @default("INR")
  status           ProductStatus             @default(DRAFT)
  inventoryCount   Int                       @default(0) @map("inventory_count")
  stockStatus      InventoryStatus           @default(IN_STOCK) @map("stock_status")
  isFeatured       Boolean                   @default(false) @map("is_featured")
  homepageDisplay  Boolean                   @default(false) @map("homepage_display")
  brandPageDisplay Boolean                   @default(false) @map("brand_page_display")
  isDemo           Boolean                   @default(true) @map("is_demo")
  seedSource       String                    @default("sheet-demo") @map("seed_source")
  publishedAt      DateTime?                 @map("published_at")
  launchNote       String?                   @map("launch_note") @db.Text
  fabric           String?
  fit              String?
  tags             String[]                  @default([])
  availableSizes   String[]                  @default([]) @map("available_sizes")
  availableColors  String[]                  @default([]) @map("available_colors")
  mainImageUrl     String?                   @map("main_image_url")
  sellerProfile    SellerProfile?            @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
  brand            Brand                     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category         Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  variants         ProductVariant[]
  inventoryRecords Inventory[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  collections      ProductCollection[]
  communityPosts   CommunityPostProduct[]
  searchKeywords   SearchKeyword[]
  aiJobs           AiJob[]                   @relation("ProductAiJobs")
  validations      SellerProductValidation[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([sellerProfileId])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductCollection {
  productId    String     @map("product_id")
  collectionId String     @map("collection_id")
  sortOrder    Int        @default(0) @map("sort_order")
  isPrimary    Boolean    @default(false) @map("is_primary")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

model ProductImage {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  url            String
  altText        String?  @map("alt_text")
  sourceFileName String?  @map("source_file_name")
  sortOrder      Int      @default(0) @map("sort_order")
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id               String         @id @default(cuid())
  productId        String         @map("product_id")
  name             String
  sku              String         @unique
  size             String?
  color            String?
  material         String?
  stock            Int            @default(0)
  priceCents       Int?           @map("price_cents")
  currency         String         @default("INR")
  isDefault        Boolean        @default(false) @map("is_default")
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryRecords Inventory[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id               String          @id @default(cuid())
  productId        String          @map("product_id")
  productVariantId String?         @map("product_variant_id")
  sellerProfileId  String?         @map("seller_profile_id")
  sku              String?
  stockOnHand      Int             @default(0) @map("stock_on_hand")
  reservedStock    Int             @default(0) @map("reserved_stock")
  availableStock   Int             @default(0) @map("available_stock")
  status           InventoryStatus @default(IN_STOCK)
  restockNote      String?         @map("restock_note") @db.Text
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  sellerProfile    SellerProfile?  @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([productId])
  @@index([productVariantId])
  @@index([sellerProfileId])
  @@map("inventory")
}

model Cart {
  id             String       @id @default(cuid())
  buyerProfileId String       @map("buyer_profile_id")
  status         CartStatus   @default(ACTIVE)
  currency       String       @default("INR")
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  items          CartItem[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([buyerProfileId])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String          @map("cart_id")
  productId        String          @map("product_id")
  productVariantId String?         @map("product_variant_id")
  selectedSize     String?         @map("selected_size")
  selectedColor    String?         @map("selected_color")
  quantity         Int             @default(1)
  unitPriceCents   Int             @map("unit_price_cents")
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([cartId])
  @@index([productId])
  @@index([productVariantId])
  @@map("cart_items")
}

model Wishlist {
  id             String         @id @default(cuid())
  buyerProfileId String         @map("buyer_profile_id")
  name           String         @default("Saved Items")
  status         WishlistStatus @default(ACTIVE)
  buyerProfile   BuyerProfile   @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  items          WishlistItem[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([buyerProfileId])
  @@map("wishlists")
}

model WishlistItem {
  id               String          @id @default(cuid())
  wishlistId       String          @map("wishlist_id")
  productId        String          @map("product_id")
  productVariantId String?         @map("product_variant_id")
  selectedSize     String?         @map("selected_size")
  selectedColor    String?         @map("selected_color")
  wishlist         Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([wishlistId])
  @@index([productId])
  @@index([productVariantId])
  @@map("wishlist_items")
}

model SavedBrand {
  id             String       @id @default(cuid())
  buyerProfileId String       @map("buyer_profile_id")
  brandId        String       @map("brand_id")
  notes          String?      @db.Text
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([buyerProfileId, brandId])
  @@index([brandId])
  @@map("saved_brands")
}

model StylePreference {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  label         String
  gender        String?
  preferredFit  String?  @map("preferred_fit")
  budgetRange   String?  @map("budget_range")
  colorFamilies String[] @default([]) @map("color_families")
  styleTags     String[] @default([]) @map("style_tags")
  occasionTags  String[] @default([]) @map("occasion_tags")
  sizeProfile   Json?    @map("size_profile")
  consentForAi  Boolean  @default(false) @map("consent_for_ai")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("style_preferences")
}

model Address {
  id             String        @id @default(cuid())
  userId         String?       @map("user_id")
  buyerProfileId String?       @map("buyer_profile_id")
  label          String?
  fullName       String?       @map("full_name")
  phoneNumber    String?       @map("phone_number")
  line1          String
  line2          String?
  city           String
  state          String?
  postalCode     String?       @map("postal_code")
  country        String        @default("India")
  isDefault      Boolean       @default(false) @map("is_default")
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  buyerProfile   BuyerProfile? @relation(fields: [buyerProfileId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([buyerProfileId])
  @@map("addresses")
}

model Order {
  id                  String          @id @default(cuid())
  buyerProfileId      String          @map("buyer_profile_id")
  status              OrderStatus     @default(PLACED)
  subtotalCents       Int             @map("subtotal_cents")
  shippingCents       Int             @default(0) @map("shipping_cents")
  totalCents          Int             @map("total_cents")
  currency            String          @default("INR")
  notes               String?         @db.Text
  shippingAddressJson Json?           @map("shipping_address_json")
  placedAt            DateTime        @default(now()) @map("placed_at")
  buyerProfile        BuyerProfile    @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  payments            Payment[]
  shipments           Shipment[]
  returnRequests      ReturnRequest[]
  supportTickets      SupportTicket[]
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  refunds             Refund[]

  @@index([buyerProfileId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String          @map("order_id")
  productId        String          @map("product_id")
  productVariantId String?         @map("product_variant_id")
  sellerProfileId  String?         @map("seller_profile_id")
  selectedSize     String?         @map("selected_size")
  selectedColor    String?         @map("selected_color")
  quantity         Int             @default(1)
  unitPriceCents   Int             @map("unit_price_cents")
  lineTotalCents   Int             @map("line_total_cents")
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  sellerProfile    SellerProfile?  @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
  returnItems      ReturnItem[]
  reviews          Review[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([sellerProfileId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @map("order_id")
  provider          String
  providerReference String?       @map("provider_reference")
  status            PaymentStatus @default(PENDING)
  amountCents       Int           @map("amount_cents")
  currency          String        @default("INR")
  notes             String?       @db.Text
  paidAt            DateTime?     @map("paid_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id                String         @id @default(cuid())
  paymentId         String?        @map("payment_id")
  orderId           String?        @map("order_id")
