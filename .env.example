# SKXNZ private beta environment template.
# Copy to .env.local for local work or configure these values in the private
# deployment provider. Never commit real secrets.

# App identity
NEXT_PUBLIC_APP_NAME="SKXNZ"
# Use the approved canonical production origin. Use an approved QA origin only
# in that deployment environment; do not point a production build at localhost.
NEXT_PUBLIC_APP_URL="https://skxnz.com"
NEXT_PUBLIC_SITE_URL="https://skxnz.com"
NEXT_PUBLIC_PRIVATE_BETA_MODE="true"
NEXT_PUBLIC_WAITLIST_URL="/waitlist"
NEXT_PUBLIC_SELLER_APPLICATION_URL="/sell"

# Legacy Prisma placeholders. The current Next/Supabase application path does
# not read these values; do not add production credentials unless Prisma is
# deliberately introduced in a separate reviewed change.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Supabase (auth + database). These names MUST match the code exactly —
# see lib/supabase/client.ts, lib/supabase/server.ts, lib/supabase/admin.ts.
# Get the values from the Supabase dashboard: Project Settings -> API.

# Public values — safe in the browser. Keep the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-anon-key"

# SERVER ONLY — never add a NEXT_PUBLIC_ prefix, never expose to the browser.
# Used only by lib/supabase/admin.ts (service-role client, bypasses RLS).
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key-server-only"

# Storage placeholders for future seller/community/AI media.
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI backend placeholders. Keep AI_PROVIDER=local unless a safe server-side
# provider key is configured.
AI_PROVIDER="local"
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL=""
OPENAI_API_KEY=""

# Optional future commerce placeholders. Do not enable live payments for private
# beta until payment, refund, tax, and order workflows are approved.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Analytics/monitoring placeholders for later private beta observation.
NEXT_PUBLIC_ANALYTICS_ID=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Cloudflare Turnstile (human verification on auth forms) ---
# Public site key — safe to expose to the browser. Rendered into the widget.
# Leave blank locally to use Cloudflare's always-pass TEST key (dev only).
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=""
# Secret key — SERVER ONLY, never sent to the browser, never logged.
# Used for Cloudflare Siteverify on standalone forms and, once you enable
# CAPTCHA in the Supabase dashboard (Authentication -> Bot & Abuse Protection
# -> Cloudflare Turnstile), by Supabase to verify the forwarded captchaToken.
# Leave blank locally to use Cloudflare's TEST secret (dev only, not real
# protection).
CLOUDFLARE_TURNSTILE_SECRET_KEY=""
