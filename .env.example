# SKXNZ private beta environment template.
# Copy to .env.local for local work or configure these values in the private
# deployment provider. Never commit real secrets.

# App identity
NEXT_PUBLIC_APP_NAME="SKXNZ"
NEXT_PUBLIC_APP_URL="https://private-beta.example.com"
NEXT_PUBLIC_SITE_URL="https://private-beta.example.com"
NEXT_PUBLIC_PRIVATE_BETA_MODE="true"
NEXT_PUBLIC_WAITLIST_URL="/waitlist"
NEXT_PUBLIC_SELLER_APPLICATION_URL="/sell"

# Database placeholders. Required only when real Prisma-backed persistence is
# enabled. Current private beta UI can still run with demo/static data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Future auth placeholders. Do not store passwords manually in SKXNZ.
AUTH_SECRET=""
AUTH_URL="https://private-beta.example.com"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://private-beta.example.com"
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Storage placeholders for future seller/community/AI media.
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI backend placeholders. Keep AI_PROVIDER=local unless a safe server-side
# provider key is configured.
AI_PROVIDER="local"
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL=""
OPENAI_API_KEY=""

# Optional future commerce placeholders. Do not enable live payments for private
# beta until payment, refund, tax, and order workflows are approved.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Analytics/monitoring placeholders for later private beta observation.
NEXT_PUBLIC_ANALYTICS_ID=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
